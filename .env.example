# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random 32+ byte secret for signing session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The site's public URL, e.g. https://fedramp-quest.vercel.app
NEXTAUTH_URL=

# The only Google account allowed to sign in and save progress
OWNER_EMAIL=

# Upstash Redis (Vercel Marketplace > Upstash, or console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
